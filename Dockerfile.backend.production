# syntax=docker/dockerfile:1

FROM golang:1.26-alpine AS builder

WORKDIR /build

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/cmd ./cmd
COPY backend/data ./data
COPY backend/internal ./internal

ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -buildvcs=false -ldflags="-s -w" \
    -o /out/nihongo-master-api ./cmd/api

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 10001 app \
    && adduser -S -D -H -u 10001 -G app app \
    && mkdir -p /app/data \
    && chown 10001:10001 /app/data

WORKDIR /app

COPY --from=builder --chown=10001:10001 /out/nihongo-master-api ./backend-app
COPY --chown=10001:10001 backend/assets/ ./assets/
COPY --chown=10001:10001 backend/third_party/ ./third_party/

ENV PORT=18084 \
    ASSET_DIRECTORY=/app/assets \
    BRANDING_CONFIG_PATH=/app/data/branding.json

USER 10001:10001

EXPOSE 18084

ENTRYPOINT ["/app/backend-app"]
