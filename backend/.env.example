# Production server template. Replace every YOUR_* value before using it.
PORT=18100
BRANDING_ADMIN_TOKEN=
BRANDING_CONFIG_PATH=data/branding.json
# Carousel settings and uploaded images persist under this config's directory.
# Empty admin token uses BRANDING_ADMIN_TOKEN.
HOME_BANNERS_CONFIG_PATH=data/home-banners.json
HOME_BANNERS_ADMIN_TOKEN=
# Display price in IDR; admin writes reuse BRANDING_ADMIN_TOKEN if left empty.
PRICING_CONFIG_PATH=data/pricing.json
PRICING_ADMIN_TOKEN=
# Runtime update policy; admin writes reuse BRANDING_ADMIN_TOKEN if left empty.
APP_UPDATE_CONFIG_PATH=data/app-updates.json
APP_UPDATE_ADMIN_TOKEN=
GOOGLE_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_WEB_CLIENT_SECRET
GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com

# Optional dedicated Google Play reviewer account. Keep real values only in the
# deployment backend/.env file; the account receives premium access without a purchase.
PLAY_REVIEW_EMAIL=
PLAY_REVIEW_PASSWORD=

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET_URL=

# Manga: curated Japanese catalog, seven-day source cooldown, COS page cache.
# Reads use MariaDB + COS only. Empty token uses BRANDING_ADMIN_TOKEN.
MANGA_SYNC_ENABLED=true
MANGA_ADMIN_TOKEN=
# Only used by the optional standalone cmd/manga-api service.
MANGA_PORT=8081
# Account API used by the isolated Manga service to validate lifetime access.
MANGA_AUTH_API_BASE_URL=http://127.0.0.1:8080/v1

# MariaDB: accounts, billing, XP/progress, dictionary cache/archive.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nihongo
DB_USER=YOUR_NIHONGO_DB_USER
DB_PASSWORD=YOUR_NIHONGO_DB_PASSWORD
DB_TLS=false

# Lifetime: create one-time/non-consumable products in both store consoles.
LIFETIME_PRODUCT_ID=nihongo_master_lifetime
ANDROID_PACKAGE_ID=com.codeverta.nihongomaster
# Server-only service account key, mounted outside the image/repository.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PLAY_USE_ADC=false
# Authenticated Pub/Sub push identity and exact HTTPS endpoint audience.
GOOGLE_PLAY_PUSH_EMAIL=
GOOGLE_PLAY_PUSH_AUDIENCE=
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# Use Sandbox on a separate test deployment; never enable sandbox in production.
APPLE_ENVIRONMENT=Production

# Firebase announcements. Private service-account key stays only on the server.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
NOTIFICATIONS_CONFIG_PATH=data/notifications.json
# Empty uses BRANDING_ADMIN_TOKEN (same admin password as branding).
NOTIFICATIONS_ADMIN_TOKEN=

# Japan jobs: MariaDB-backed public catalog and cautious employer-feed sync.
# Allowed values only: 168=weekly (default), 84=twice weekly. Durable domain
# deadline prevents restart/manual command from bypassing the request budget.
JOBS_SYNC_ENABLED=true
JOBS_SYNC_INTERVAL_HOURS=168

# Dictionary cache administration; empty uses BRANDING_ADMIN_TOKEN.
DICTIONARY_ADMIN_TOKEN=

# Flutter crash/error monitoring; empty uses BRANDING_ADMIN_TOKEN.
DIAGNOSTICS_ADMIN_TOKEN=

# News: durable calendar schedules are edited in /admin/news (Asia/Jakarta).
# Disable only the automatic worker; public reads still use stored MariaDB data.
NEWS_SYNC_ENABLED=true
# Empty uses BRANDING_ADMIN_TOKEN, then DICTIONARY_ADMIN_TOKEN.
NEWS_ADMIN_TOKEN=
